# An rclone destination whose bucket/provider enforces immutable retention.
# Form must be name:bucket[/prefix] — retention verification derives the
# bucket and key prefix from this value.
# Example: pirate-b2:hns-edge-production/snapshots
BACKUP_RCLONE_REMOTE=
# age public recipient only. Keep the private recovery identity offline.
BACKUP_AGE_RECIPIENT=
RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# Post-upload proof that the provider applied COMPLIANCE Object Lock to the
# uploaded objects. Must be exactly 'true' or 'false'; 'false' logs a loud
# warning every run. Uses the S3 API (GetObjectRetention) with the same
# scoped uploader credential rclone uses (readFileRetentions capability).
BACKUP_RETENTION_VERIFY=true
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Fail the run if effective retention is weaker than this many days.
BACKUP_MIN_RETENTION_DAYS=30

# Failed runs trigger pirate-hns-state-backup-alert@%n.service, which posts
# {"text": ...} here — the same sink the API's ops-alerts use.
OPS_ALERT_WEBHOOK_URL=
# Optional root-readable file containing the dedicated bearer token for an
# authenticated Pirate alert ingress. Do not put the token itself in this env.
OPS_ALERT_BEARER_TOKEN_FILE=
# Read by the success-only heartbeat helper after a completed backup.
DEPLOY_ROOT=/srv/pirate-hns

BACKUP_STAGING_ROOT=/var/lib/pirate-hns-backup
PDNS_SQLITE_DB=/srv/pirate-hns/app/ops/vps/hns-authoritative-dns/data/pdns.sqlite3
SPACES_DATA_DIR=/srv/pirate-spaces/data
HNS_RUNTIME_STATE_DIR=/var/lib/pirate-hns
HNS_DANE_CERT_DIR=/etc/caddy/hns-dane

# Space-separated units. Active units are stopped for the shortest possible
# window and restarted even if archive/upload fails.
BACKUP_QUIESCE_UNITS=pirate-community-protocol-subsd.service pirate-spaces-verifier.service pirate-protocol-spaced.service
