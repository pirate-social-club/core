[Unit]
Description=Encrypted backup of Pirate HNS and Spaces edge state
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/srv/pirate-hns/config/hns-state-backup.env
ExecStart=/srv/pirate-hns/app/ops/vps/hns-state-backup/hns-state-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
