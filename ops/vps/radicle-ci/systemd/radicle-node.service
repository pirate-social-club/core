[Unit]
Description=Pirate Radicle seed node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radicle
Group=radicle
Environment=RAD_HOME=/var/lib/radicle
ExecStart=/usr/bin/radicle-node --config /var/lib/radicle/config.json --secret /var/lib/radicle/keys/radicle --log-logger systemd
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
Slice=radicle-core.slice
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/radicle
LimitNOFILE=4096
TasksMax=768

[Install]
WantedBy=multi-user.target
