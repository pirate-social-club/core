[Unit]
Description=Reconcile signed Radicle CI proof announcements
After=radicle-node.service
Requires=radicle-node.service

[Service]
Type=oneshot
User=radicle
Group=radicle
Environment=HOME=/var/lib/radicle
Environment=RAD_HOME=/var/lib/radicle
Environment=XDG_CONFIG_HOME=/var/lib/radicle/.config
ExecStart=/usr/local/libexec/pirate-radicle/announce-ci-proofs
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/radicle
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX

