# Immutable rclone destination in name:bucket[/prefix] form.
BACKUP_RCLONE_REMOTE=
# Public age recipient only. The encrypted private identity is human-retrieved
# from the separate recovery organization; it never exists on VPS #3.
BACKUP_AGE_RECIPIENT=
# ProtectHome hides /root from the backup unit. Install the bucket-scoped
# rclone config at this root-only path instead.
RCLONE_CONFIG=/etc/pirate-radicle/proof-state-rclone.conf

# Provider Object Lock verification. Production must use true.
BACKUP_RETENTION_VERIFY=true
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_MIN_RETENTION_DAYS=30

# Dedicated backup-only signer. Never use a Radicle delegate or seed key here.
PROOF_BACKUP_SIGNING_KEY=/etc/pirate-radicle/proof-backup-signing-key
PROOF_BACKUP_SIGNING_PUBLIC_KEY=/etc/pirate-radicle/proof-backup-signing-key.pub
PROOF_BACKUP_STAGING_ROOT=/var/lib/radicle-proof-backup
RAD_STORAGE=/var/lib/radicle/storage
PROMOTION_STATE_DIR=/var/lib/promotion
PROMOTION_CONTROLLER_UNIT=promotion-controller.service
CI_PRODUCER_NID=z6MkeUhmbivWz5Uv87h9iT4tQk7xusZabMHCrjTKEGaCTUx4
RADICLE_CI_REPOSITORIES_FILE=/etc/pirate-radicle/repositories

# Failure notifications. The bearer token file is optional; if configured it
# must be root-owned mode 0600.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_BEARER_TOKEN_FILE=
