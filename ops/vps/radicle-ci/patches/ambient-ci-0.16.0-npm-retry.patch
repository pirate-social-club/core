diff --git a/src/action_impl/bun.rs b/src/action_impl/bun.rs
new file mode 100644
index 0000000..c8f9674
--- /dev/null
+++ b/src/action_impl/bun.rs
@@ -0,0 +1,259 @@
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    error::Error,
+    fs::{self, File},
+    io::{self, Write},
+    path::{Component, Path, PathBuf},
+};
+
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use url::Url;
+
+use crate::{
+    action::{ActionError, Context},
+    action_impl::ActionImpl,
+    util::{http_get_to_file, mkdir, UtilError},
+};
+
+const LOCK_FILE: &str = "bun.lock";
+const SUBDIR: &str = "bun";
+
+/// Download registry packages from a Bun lock file into the pre-plan
+/// dependency directory. Local `file:`, `workspace:`, and `link:` entries are
+/// intentionally skipped; the plan must provision those source trees itself.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct BunGet {
+    /// Relative source subdirectory containing the lock file.
+    #[serde(default)]
+    path: Option<PathBuf>,
+
+    /// Relative output directory name below the Bun dependency directory.
+    #[serde(default)]
+    output: Option<PathBuf>,
+}
+
+impl BunGet {
+    /// Construct a Bun dependency action.
+    pub(crate) fn new(path: Option<PathBuf>, output: Option<PathBuf>) -> Self {
+        Self { path, output }
+    }
+
+    fn source_path(&self, source_dir: &Path) -> Result<PathBuf, BunError> {
+        let path = self.path.as_deref().unwrap_or_else(|| Path::new("."));
+        validate_relative(path)?;
+        Ok(source_dir.join(path))
+    }
+
+    fn output_path(&self, deps_dir: &Path) -> Result<PathBuf, BunError> {
+        let output = self
+            .output
+            .as_deref()
+            .unwrap_or_else(|| Path::new("default"));
+        validate_relative(output)?;
+        Ok(deps_dir.join(SUBDIR).join(output))
+    }
+
+    fn load_lock_file(&self, srcdir: &Path) -> Result<PackagesLock, BunError> {
+        let filename = srcdir.join(LOCK_FILE);
+        let data =
+            fs::read(&filename).map_err(|err| BunError::ReadLockFile(filename.clone(), err))?;
+        serde_norway::from_slice(&data).map_err(|err| BunError::ParseLockFile(filename, err))
+    }
+
+    fn download(&self, bun_dir: PathBuf, lockfile: PackagesLock) -> Result<(), BunError> {
+        mkdir(&bun_dir).map_err(|err| BunError::Mkdir(bun_dir.clone(), err))?;
+        let manifest_path = bun_dir.join("manifest.tsv");
+        let mut manifest = File::create(&manifest_path)
+            .map_err(|err| BunError::CreateManifest(manifest_path.clone(), err))?;
+        writeln!(manifest, "name\tversion\tfilename\tintegrity")
+            .map_err(|err| BunError::WriteManifest(manifest_path.clone(), err))?;
+
+        let mut seen = BTreeSet::new();
+        let mut ordinal = 0usize;
+        for (key, entry) in lockfile.packages {
+            if key.is_empty() {
+                continue;
+            }
+            let spec = entry.first().and_then(Value::as_str).ok_or_else(|| {
+                BunError::InvalidPackage(key.clone(), "missing package spec".into())
+            })?;
+            if is_local_spec(spec) {
+                continue;
+            }
+
+            let (name, version) = parse_registry_spec(spec)
+                .ok_or_else(|| BunError::InvalidPackage(key.clone(), spec.into()))?;
+            if !seen.insert((name.clone(), version.clone())) {
+                continue;
+            }
+
+            let url = package_url(&name, &version)
+                .map_err(|err| BunError::UrlParse(name.clone(), err))?;
+            let filename = format!("{ordinal}.tgz");
+            let destination = bun_dir.join(&filename);
+            http_get_to_file(url.as_str(), &destination)
+                .map_err(|err| BunError::HttpGet(url.clone(), destination.clone(), err))?;
+            let integrity = entry.get(3).and_then(Value::as_str).unwrap_or("-");
+            writeln!(manifest, "{name}\t{version}\t{filename}\t{integrity}")
+                .map_err(|err| BunError::WriteManifest(manifest_path.clone(), err))?;
+            ordinal += 1;
+        }
+        manifest
+            .flush()
+            .map_err(|err| BunError::WriteManifest(manifest_path, err))?;
+        Ok(())
+    }
+}
+
+impl ActionImpl for BunGet {
+    fn execute(&self, context: &mut Context) -> Result<(), ActionError> {
+        let result = self
+            .load_lock_file(&self.source_path(context.source_dir())?)
+            .and_then(|lockfile| self.download(self.output_path(context.deps_dir())?, lockfile));
+        result.map_err(ActionError::from)
+    }
+}
+
+fn validate_relative(path: &Path) -> Result<(), BunError> {
+    if path.is_absolute()
+        || path
+            .components()
+            .any(|component| matches!(component, Component::ParentDir))
+    {
+        return Err(BunError::InvalidPath(path.to_path_buf()));
+    }
+    Ok(())
+}
+
+fn is_local_spec(spec: &str) -> bool {
+    ["file:", "workspace:", "link:"]
+        .iter()
+        .any(|prefix| spec.starts_with(prefix))
+}
+
+fn parse_registry_spec(spec: &str) -> Option<(String, String)> {
+    let (name, version) = spec.rsplit_once('@')?;
+    if name.is_empty() || version.is_empty() || name.starts_with("http") {
+        return None;
+    }
+    Some((name.to_string(), version.to_string()))
+}
+
+fn package_url(name: &str, version: &str) -> Result<Url, url::ParseError> {
+    let basename = name.rsplit('/').next().unwrap_or(name);
+    Url::parse(&format!(
+        "https://registry.npmjs.org/{name}/-/{basename}-{version}.tgz"
+    ))
+}
+
+#[derive(Debug, Deserialize)]
+struct PackagesLock {
+    #[serde(default)]
+    packages: BTreeMap<String, Vec<Value>>,
+}
+
+/// Errors from the Bun dependency action.
+#[derive(Debug, thiserror::Error)]
+pub enum BunError {
+    /// Can't read the Bun lock file.
+    #[error("failed to read lock file {0}")]
+    ReadLockFile(PathBuf, #[source] io::Error),
+
+    /// Can't parse the Bun lock file.
+    #[error("failed to parse lock file {0}")]
+    ParseLockFile(PathBuf, #[source] serde_norway::Error),
+
+    /// Can't create the dependency directory.
+    #[error("could not create dependency directory {0}")]
+    Mkdir(PathBuf, #[source] UtilError),
+
+    /// A source or output path escaped its allowed root.
+    #[error("path must be relative and cannot contain '..': {0}")]
+    InvalidPath(PathBuf),
+
+    /// A lock entry was neither a local source nor a registry package.
+    #[error("unsupported Bun lock package {0}: {1}")]
+    InvalidPackage(String, String),
+
+    /// A package URL could not be parsed.
+    #[error("failed to build package URL for {0:?}")]
+    UrlParse(String, #[source] url::ParseError),
+
+    /// Download failed.
+    #[error("failed to download {0} to {1}")]
+    HttpGet(Url, PathBuf, #[source] UtilError),
+
+    /// Can't create the manifest.
+    #[error("failed to create Bun dependency manifest {0}")]
+    CreateManifest(PathBuf, #[source] io::Error),
+
+    /// Can't write the manifest.
+    #[error("failed to write Bun dependency manifest {0}")]
+    WriteManifest(PathBuf, #[source] io::Error),
+}
+
+impl From<BunError> for ActionError {
+    fn from(value: BunError) -> Self {
+        Self::Bun(value)
+    }
+}
+
+impl From<BunError> for String {
+    fn from(err: BunError) -> Self {
+        let mut msg = format!("ERROR: {err}");
+        let mut source = err.source();
+        while let Some(src) = source {
+            msg.push_str(&format!("caused by: {src}"));
+            source = src.source();
+        }
+        msg
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_scoped_and_unscoped_registry_specs() {
+        assert_eq!(
+            parse_registry_spec("@types/node@24.12.3"),
+            Some(("@types/node".into(), "24.12.3".into()))
+        );
+        assert_eq!(
+            parse_registry_spec("typescript@7.0.2"),
+            Some(("typescript".into(), "7.0.2".into()))
+        );
+        assert_eq!(parse_registry_spec("file:../local"), None);
+    }
+
+    #[test]
+    fn parses_bun_lock_trailing_commas() {
+        let lock: PackagesLock = serde_norway::from_str(
+            r#"{
+              "packages": {
+                "@types/node": ["@types/node@24.12.3", "", {}, "sha512-test"],
+                "local": ["local@file:packages/local"]
+              },
+            }"#,
+        )
+        .expect("Bun lock should accept its trailing-comma JSON");
+        assert_eq!(lock.packages.len(), 2);
+    }
+
+    #[test]
+    fn package_urls_preserve_scoped_names() {
+        assert_eq!(
+            package_url("@types/node", "24.12.3").unwrap().as_str(),
+            "https://registry.npmjs.org/@types/node/-/node-24.12.3.tgz"
+        );
+    }
+
+    #[test]
+    fn paths_cannot_escape_the_checkout() {
+        assert!(validate_relative(Path::new("../outside")).is_err());
+        assert!(validate_relative(Path::new("/absolute")).is_err());
+        assert!(validate_relative(Path::new("packages/local")).is_ok());
+    }
+}
