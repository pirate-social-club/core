#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1090
source "${RADICLE_CI_ALLOWLIST_LIBRARY:-$script_dir/repository-allowlist.sh}"

template=${1:-$script_dir/../config/ci-broker.yaml.template}
output=${2:-/dev/stdout}
load_repository_allowlist

if [[ ! -r "$template" ]]; then
  echo "broker template is not readable: $template" >&2
  exit 1
fi
if [[ $(grep -Fc '@@REPOSITORY_FILTERS@@' "$template") -ne 1 ]]; then
  echo "broker template must contain exactly one repository marker" >&2
  exit 1
fi

tmp=$(mktemp)
trap 'rm -f -- "$tmp"' EXIT
while IFS= read -r line; do
  if [[ "$line" == *'@@REPOSITORY_FILTERS@@'* ]]; then
    for rid in "${RADICLE_CI_RIDS[@]}"; do
      printf '          - !Repository "%s"\n' "$rid"
    done
  else
    printf '%s\n' "$line"
  fi
done < "$template" > "$tmp"

if [[ "$output" == /dev/stdout ]]; then
  cat "$tmp"
else
  install -m 0600 "$tmp" "$output"
fi
