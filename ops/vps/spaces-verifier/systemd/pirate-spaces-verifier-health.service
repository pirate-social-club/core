[Unit]
Description=Check Pirate Spaces Fabric record reader health
After=network-online.target pirate-spaces-verifier.service
Wants=network-online.target
OnFailure=pirate-spaces-verifier-health-alert.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/pirate-deployment-verify/spaces.env
ExecStart=/bin/bash -c 'exec "$DEPLOY_ROOT/current/bin/check-verifier-health.sh"'
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
LockPersonality=true
UMask=0077
