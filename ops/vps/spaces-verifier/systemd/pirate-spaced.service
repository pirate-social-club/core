[Unit]
Description=Pirate verification-only Spaces daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pirate-spaces
Group=pirate-spaces
EnvironmentFile=/srv/pirate-spaces/config/spaced.env
ExecStart=/srv/pirate-spaces/current/bin/start-spaced.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/srv/pirate-spaces/data/spaced
UMask=0077

[Install]
WantedBy=multi-user.target
