# Public endpoint the health check probes. Must be the published URL, not a
# loopback backend -- the point is to prove the whole chain serves.
HNS_DOH_ENDPOINT=https://dns.pirate.sc/dns-query

# A name that must always resolve. app.pirate is served by our own authoritative
# zone, so this does not depend on a third party staying up.
HNS_DOH_PROBE_NAME=app.pirate

HNS_DOH_TIMEOUT_SECONDS=15
HNS_DOH_ATTEMPTS=3
HNS_DOH_BASE_DELAY_SECONDS=2
