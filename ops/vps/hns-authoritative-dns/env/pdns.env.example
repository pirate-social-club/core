PDNS_API_KEY=
PDNS_API_URL=http://127.0.0.1:8081
PDNS_SERVER_ID=localhost
HNS_VERIFIER_URL=http://127.0.0.1:4048
# HNS_VERIFIER_AUTH_TOKEN is secret and comes from Infisical.
HNS_AUTHORITATIVE_TLSA_TTL=300
HNS_TLSA_STATE_PATH=/var/lib/pirate-hns/tlsa-rollover.json
# Optional comma-separated subset. Empty means every PowerDNS zone.
HNS_TLSA_ZONE_ALLOWLIST=
PDNS_SQLITE_DB=/var/lib/powerdns/pdns.sqlite3
PDNS_LOCAL_ADDRESS=0.0.0.0
PDNS_WEBSERVER_ADDRESS=127.0.0.1
PDNS_WEBSERVER_PORT=8081
