NS2_PUBLIC_IP=
PRIMARY_DNS_IP=
# Imported once during bootstrap; do not store the real value in this file.
PDNS_AXFR_TSIG_KEY_NAME=pirate-axfr
PDNS_AXFR_TSIG_ALGORITHM=hmac-sha256
PDNS_AXFR_TSIG_SECRET=
# Must be an NS owner present in every zone that this autoprimary may create.
PDNS_AUTOPRIMARY_NAMESERVER=ns2.pirate
PDNS_AUTOPRIMARY_ACCOUNT=pirate-primary
