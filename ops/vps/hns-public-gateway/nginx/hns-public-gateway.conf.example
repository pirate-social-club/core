# All HNS hostnames route through the Bun gateway (127.0.0.1:4049), which owns
# routing (app/api/apex, usernames, reserved-host 404s, and the dynamic
# arbitrary-root catchall via /public-namespaces/:root). The gateway injects
# x-pirate-hns-host and the timestamped forwarder signature itself.
#
# default_server makes this a true catchall: arbitrary verified community
# roots (any hostname) reach the gateway instead of dying in proxy config.
# For HTTPS, terminate TLS with per-zone self-signed certs + DANE-EE TLSA
# records under DNSSEC; plain HTTP stays available for HNS clients without
# DANE support (non-canonical origins are public/read-only in the app).

server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;

  location / {
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_pass http://127.0.0.1:4049;
  }
}
