# All HNS hostnames route through the Bun gateway (127.0.0.1:4049), which owns
# routing: app.<root>/apex -> app origin, api.<root> -> API origin, usernames ->
# public profile pages, other reserved hosts -> 404, and ANY other hostname ->
# dynamic /public-namespaces/:root resolution. Keeping routing in the gateway
# (tested code) instead of proxy config means the catchall genuinely covers
# arbitrary community roots.
#
# The gateway injects x-pirate-hns-host and the forwarder token itself
# (HNS_PUBLIC_FORWARDER_AUTH_TOKEN in its env) — do not add header_up overrides
# for those here.
#
# This is the local/trusted-private-CA variant. Caddy creates a different key
# for each on-demand hostname, so one wildcard DANE-EE TLSA association CANNOT
# authenticate these certificates. Use Caddyfile.dane.example for the public
# DNSSEC+DANE path. Plain HTTP stays available for HNS clients without DANE
# support — non-canonical origins are public/read-only in the app.
{
	local_certs
	# Preserve the explicit http:// reverse proxy below. The Bun gateway, not
	# Caddy, enforces GET/HEAD-only behavior and strips credentials on HTTP.
	auto_https disable_redirects
	# Required with on-demand TLS: Caddy sends ?domain=<SNI> to this loopback-only
	# permission service and issues only on a 2xx response. The gateway checks
	# first-party profile/agent existence or a currently routable verified HNS
	# namespace. Never expose port 4050 publicly.
	on_demand_tls {
		ask http://127.0.0.1:4050/ask
	}
}

https:// {
	tls internal {
		on_demand
	}
	reverse_proxy 127.0.0.1:4049
}

http:// {
	reverse_proxy 127.0.0.1:4049
}
