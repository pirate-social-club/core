HNS_PUBLIC_GATEWAY_HOST=127.0.0.1
HNS_PUBLIC_GATEWAY_PORT=4049
# Dedicated Caddy on-demand TLS permission listener. The service always binds
# this port to 127.0.0.1 regardless of other host settings; do not publish it.
HNS_PUBLIC_CADDY_ASK_PORT=4050
# Persistent per-verification hostname grants bound local-certificate storage.
HNS_PUBLIC_CADDY_ASK_DB_PATH=/var/lib/pirate-hns/caddy-ask.sqlite
HNS_PUBLIC_CADDY_MAX_HOSTS_PER_NAMESPACE=64
HNS_PUBLIC_GATEWAY_ROOT_SUFFIX=pirate
HNS_PUBLIC_GATEWAY_AGENT_SUFFIX=clawitzer
HNS_PUBLIC_GATEWAY_EXTERNAL_SCHEME=https
HNS_PUBLIC_API_ORIGIN=https://api.pirate.sc
HNS_PUBLIC_APP_ORIGIN=https://pirate.sc
# Imported-root resolution is coalesced and cached. Stale entries remain usable
# during brief API failures after the fresh TTL expires.
HNS_PUBLIC_NAMESPACE_RESOLVE_TIMEOUT_MS=2000
HNS_PUBLIC_NAMESPACE_CACHE_TTL_MS=30000
HNS_PUBLIC_NAMESPACE_CACHE_STALE_MS=300000
HNS_PUBLIC_NAMESPACE_CACHE_MAX_ENTRIES=2048
# Secret HMAC key used to sign every proxied request. Use at least 32 random
# bytes and store the matching Worker key as a secret. The Worker also requires
# the gateway source IP before honoring any x-pirate-hns-* routing context.
HNS_PUBLIC_FORWARDER_HMAC_KEY=
# Temporary legacy credential for the initial dual-emit rollout only.
HNS_PUBLIC_FORWARDER_AUTH_TOKEN=
# Set true only after every downstream Worker verifies HMAC. Token-only gateway
# configuration then fails closed even if the legacy credential is still set.
HNS_PUBLIC_FORWARDER_REQUIRE_HMAC=false
# Optional exact HNS host -> Cloudflare static origin map. Leave empty until
# the target site is deployed and verified.
HNS_PUBLIC_STATIC_SITE_ROUTES=
