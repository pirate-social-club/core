HNS_VERIFIER_HOST=127.0.0.1
HNS_VERIFIER_PORT=4048
HNS_VERIFIER_AUTH_TOKEN=
# Trusted Handshake root-resource reader used for owner-managed HNS TXT proof checks.
HNS_ROOT_RESOURCE_URL_TEMPLATE=https://shakeshift.com/name/{root}/resources?fetch=main
HNS_ROOT_RESOURCE_TIMEOUT_MS=4000
# Resolvers used to observe an owner's OWN authoritative DNS (owner-managed
# ownership proof). Independent of Pirate's nameservers.
HNS_OWNER_MANAGED_RESOLVERS=
# PowerDNS authoritative HTTP API (never write the backend database directly).
PDNS_API_URL=http://127.0.0.1:8081
PDNS_API_KEY=
PDNS_DEFAULT_SOA_CONTENT=ns1.pirate. dns.pirate. 0 3600 900 1209600 300
# Master so NOTIFY/AXFR to the secondary actually happens (Native zones silently
# never replicate). TSIG key name granted AXFR on each provisioned zone.
PDNS_ZONE_KIND=Master
PDNS_AXFR_TSIG_KEY_NAME=pirate-axfr
# Public IP of THIS edge host (the gateway + ns1). No default: a stale value
# here silently publishes records pointing at a machine we do not control.
HNS_AUTHORITATIVE_NAMESERVERS=ns1.pirate.
HNS_AUTHORITATIVE_TTL=300
HNS_AUTHORITATIVE_NAMESERVER_IPV4=
HNS_AUTHORITATIVE_APEX_IPV4=
HNS_AUTHORITATIVE_PROFILE_IPV4=
HNS_AUTHORITATIVE_WILDCARD_IPV4=
