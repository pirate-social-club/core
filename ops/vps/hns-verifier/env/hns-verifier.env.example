HNS_VERIFIER_HOST=127.0.0.1
HNS_VERIFIER_PORT=4048
HNS_VERIFIER_AUTH_TOKEN=
# Optional second full-access credential for zero-downtime rotation. It must
# differ from the primary and observer tokens.
HNS_VERIFIER_AUTH_TOKEN_SECONDARY=
# Optional read-only credential accepted only by the two GET /observe-root-*
# endpoints. It requires, and must differ from, HNS_VERIFIER_AUTH_TOKEN.
HNS_VERIFIER_OBSERVER_AUTH_TOKEN=
# Authenticated hsd JSON-RPC used for parent resource ownership evidence and expiry evidence.
# There is deliberately
# no URL or horizon default: missing/invalid configuration yields an unknown
# expiry assertion and withholds expiry-gated capabilities.
HNS_CHAIN_RPC_URL=
HNS_CHAIN_RPC_API_KEY=
HNS_CHAIN_RPC_TIMEOUT_MS=4000
HNS_CHAIN_NETWORK=main
HNS_CHAIN_MAX_TIP_AGE_SECONDS=
HNS_EXPIRY_HORIZON_BLOCKS=
# Independent DNSSEC validator. The resolver supplies DNS data; /usr/bin/delv
# validates it against the root-scoped DS trust anchor read from local hsd.
HNS_VALIDATING_RESOLVER_ADDRESS=127.0.0.1
HNS_VALIDATING_RESOLVER_PORT=5350
HNS_AUTHORITY_OBSERVATION_TIMEOUT_MS=10000
# Resolvers used to observe an owner's OWN authoritative DNS (owner-managed
# ownership proof). Independent of Pirate's nameservers.
HNS_OWNER_MANAGED_RESOLVERS=
# PowerDNS authoritative HTTP API (never write the backend database directly).
PDNS_API_URL=http://127.0.0.1:8081
PDNS_API_KEY=
PDNS_SECURE_NEW_ZONES=false
PDNS_DEFAULT_SOA_CONTENT=ns1.pirate. dns.pirate. 0 3600 900 1209600 300
# Master so NOTIFY/AXFR to the secondary actually happens (Native zones silently
# never replicate). TSIG key name granted AXFR on each provisioned zone.
PDNS_ZONE_KIND=Master
PDNS_AXFR_TSIG_KEY_NAME=pirate-axfr
# Resolvers used ONLY for the post-provision authority-health check (querying
# _pirate.<root> through the serving path). Point at Pirate's own nameserver.
HNS_AUTHORITY_HEALTH_RESOLVERS=
# Public IP of THIS edge host (the gateway + ns1). No default: a stale value
# here silently publishes records pointing at a machine we do not control.
HNS_AUTHORITATIVE_NAMESERVERS=ns1.pirate.
HNS_AUTHORITATIVE_TTL=300
HNS_AUTHORITATIVE_NAMESERVER_IPV4=
HNS_AUTHORITATIVE_APEX_IPV4=
HNS_AUTHORITATIVE_PROFILE_IPV4=
HNS_AUTHORITATIVE_WILDCARD_IPV4=
# Comma-separated DANE-EE SPKI SHA-256 associations. Leave empty until every
# existing zone is DNSSEC-signed and its DS is published in Handshake.
HNS_AUTHORITATIVE_TLSA_ASSOCIATIONS=
HNS_AUTHORITATIVE_TLSA_TTL=300
