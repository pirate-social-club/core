[Unit]
Description=Pirate HNS verifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pirate-hns
WorkingDirectory=/srv/pirate-hns-verifier/app
EnvironmentFile=/srv/pirate-hns-verifier/config/hns-verifier.env
ExecStartPre=/usr/bin/test -x /usr/bin/delv
ExecStartPre=/usr/bin/test -x /usr/bin/dig
ExecStart=/usr/bin/env bun services/verifier/hns/src/server.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
