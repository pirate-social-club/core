verifier.pirate.sc {
	handle_path /hns/* {
		reverse_proxy 127.0.0.1:4048
	}

	handle_path /spaces/* {
		route {
			rate_limit {
				zone spaces_resolve_per_ip {
					match {
						method GET
						path /resolve
					}
					key {remote_host}
					events 30
					window 1m
					ipv6_prefix 64
				}
			}
			reverse_proxy 127.0.0.1:4047
		}
	}

	handle_path /prod/* {
		reverse_proxy 127.0.0.1:8789
	}
}
